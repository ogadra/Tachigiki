{
  "type": "object",
  "properties": {
    "levels": {
      "type": "object",
      "properties": {
        "a2": { "$ref": "#/$defs/articles" },
        "b1": { "$ref": "#/$defs/articles" },
        "b2": { "$ref": "#/$defs/articles" }
      },
      "required": ["a2", "b1", "b2"]
    }
  },
  "required": ["levels"],
  "$defs": {
    "pair": {
      "type": "object",
      "properties": { "en": { "type": "string" }, "ja": { "type": "string" } },
      "required": ["en", "ja"]
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "$ref": "#/$defs/pair" },
          "sentences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } }
        },
        "required": ["title", "sentences"]
      }
    }
  }
}
